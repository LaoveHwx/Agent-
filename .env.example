# 复制本文件为 .env，再填写真实配置。不要把 .env 提交到 Git。

# 主模型：必须是兼容 OpenAI API 的模型服务。
MODEL_NAME=your_model_name
API_KEY=your_model_api_key
BASE_URL=https://your-model-endpoint/v1
MODEL_MAX_TOKENS=4096

# 辅助模型：用于问题分类、记忆路由等任务，也需要兼容 OpenAI API。
MODEL_NAME2=your_model_name
API_KEY2=your_model_api_key
BASE_URL2=https://your-model-endpoint/v1

# PostgreSQL：必须由后端容器能够访问，并已安装 pgvector。
# 数据库在 Docker 宿主机时，Linux Compose 可使用 host.docker.internal。
APP_DATABASE_URL=postgresql://database_user:database_password@host.docker.internal:5432/database_name

# Ollama 嵌入模型：用于知识库文档入库与向量检索。
# 请填写后端容器能够访问的 Ollama 地址；不要填写容器自己的 localhost。
EMBEDDINGS_MODEL_NAME=your_embedding_model
OLLAMA_BASE_URL=http://physical-host-ip:11434

# 可选图表 MCP。留空时只使用项目自带的数值计算 MCP，不会请求失效的远程服务。
CHART_MCP_URL=

# 网站共享登录。SECRET_KEY 至少 32 个随机字符。
APP_USERNAME=admin
APP_PASSWORD=replace_with_a_strong_password
SECRET_KEY=replace_with_at_least_32_random_characters

# 运行环境和接口跨域来源。通过同域 Nginx 访问时通常无需修改 CORS_ORIGINS。
APP_ENV=production
CORS_ORIGINS=http://localhost:8080

# 对话记忆与查询限制。Redis 地址由 Compose 自动配置，无需写入这里。
MEMORY_TTL_SECONDS=604800
MEMORY_MAX_MESSAGES=20
SQL_QUERY_TIMEOUT=10
SQL_MAX_ROWS=200
